# =============================================================================
# Paperclip AI — Komodo Stack environment
#
# In KOMODO: paste these (filled in) into the Stack's "Environment" box, or
# point env_file_path at a managed file. See komodo/stack.toml.
#
# For LOCAL/manual compose use: cp .env.example .env  and fill in below.
# =============================================================================

# ── Image ────────────────────────────────────────────────────────
# Server image run by the stack. Either the image the Komodo Build resource
# pushes (a thin layer on the official image), or the official image directly:
#   ghcr.io/paperclipai/paperclip:latest   (or pin a release, e.g. :2026.916.1)
PAPERCLIP_IMAGE=ghcr.io/OWNER/paperclip-server:latest

# ── Required ─────────────────────────────────────────────────────
# Auth secret — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Public URL where Paperclip will be reachable (matches your reverse proxy host)
PAPERCLIP_PUBLIC_URL=https://paperclip.example.com

# ── Database ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=

# ── AI Agent API Keys (optional) ─────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Must be a key restricted to the Gemini API (unrestricted keys are rejected).
GEMINI_API_KEY=

# Extra hostnames beyond the PAPERCLIP_PUBLIC_URL host, comma-separated
# (e.g. LAN/Tailscale aliases). Leave blank if not needed.
PAPERCLIP_ALLOWED_HOSTNAMES=

# ── Host / networking (optional) ─────────────────────────────────
# UID/GID to own the persistent volume — match the host user if using bind mounts.
# Applied at container start by the upstream entrypoint (no rebuild needed).
USER_UID=1000
USER_GID=1000
